# Uploads (ignore user-uploaded media but preserve directories via .gitkeep)
uploads/memoryPhotos/*
!uploads/memoryPhotos/.gitkeep
uploads/charts/*
!uploads/charts/.gitkeep

# Temporary / Log files
*.log
